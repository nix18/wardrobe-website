---
/** 「AI生成」标识：与应用中贴在 AI 图片右下角的玻璃胶囊同一版式 */
interface Props {
  dark?: boolean
}
const { dark = false } = Astro.props
---

<span class:list={['ai-mark', { dark }]}>AI生成</span>

<style>
  .ai-mark {
    position: absolute;
    right: 4%;
    bottom: 3%;
    padding: 0.32em 0.8em;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.42);
    color: #1d1a18;
    font-size: clamp(10px, 1.1vw, 13px);
    font-weight: 600;
    letter-spacing: 0.04em;
    backdrop-filter: blur(10px) saturate(1.6);
    -webkit-backdrop-filter: blur(10px) saturate(1.6);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.75),
      inset 0 0 0 1px rgb(255 255 255 / 0.35),
      0 6px 16px -8px rgb(0 0 0 / 0.35);
  }

  .ai-mark.dark {
    background: rgb(20 18 16 / 0.42);
    color: #fff;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.25),
      inset 0 0 0 1px rgb(255 255 255 / 0.12),
      0 6px 16px -8px rgb(0 0 0 / 0.5);
  }
</style>
