---
import { Picture } from 'astro:assets'
import type { Screen } from '../lib/screens'

/**
 * 手机外框里的应用截图：上方是状态栏（时间、信号、电量与灵动岛），截图在状态栏下面，不被挡住。
 * [width] 为外框宽度（CSS 像素）；[fluid] 时宽度由外层的 CSS 变量 --phone-w 决定，[width] 只用于选择图片尺寸。
 */
interface Props {
  screen: Screen
  alt: string
  width?: number
  eager?: boolean
  fluid?: boolean
  class?: string
}
const { screen, alt, width = 280, eager = false, fluid = false, class: className } = Astro.props
const { src, bar, dark = false } = screen
---

<div class:list={['phone', { 'phone-dark': dark }, className]} style={fluid ? undefined : `--phone-w: ${width}px`}>
  <div class="screen">
    <div class="status" style={`background: ${bar}`} aria-hidden="true">
      <span class="time">9:41</span>
      <span class="island"></span>
      <svg class="icons" viewBox="0 0 66 14" fill="currentColor">
        <rect x="0" y="9" width="3" height="4" rx="1"></rect><rect x="5" y="6.5" width="3" height="6.5" rx="1"></rect><rect x="10" y="4" width="3" height="9" rx="1"></rect><rect x="15" y="1.5" width="3" height="11.5" rx="1"></rect>
        <path d="M30 4.2a10.5 10.5 0 0 1 13.6 0l-1.5 1.6a8.3 8.3 0 0 0-10.6 0L30 4.2Zm2.9 3.1a6.3 6.3 0 0 1 7.8 0l-1.5 1.6a4.1 4.1 0 0 0-4.8 0l-1.5-1.6Zm2.9 3.1a2 2 0 0 1 2 0L36.8 12l-1-1.6Z"></path>
        <rect x="47.5" y="1.5" width="15" height="10" rx="3" fill="none" stroke="currentColor" stroke-opacity="0.4"></rect><rect x="49.5" y="3.5" width="9.5" height="6" rx="1.5"></rect><path d="M64 5v3.5a1.6 1.6 0 0 0 0-3.5Z" fill-opacity="0.45"></path>
      </svg>
    </div>
    <Picture
      src={src}
      alt={alt}
      widths={[width, Math.min(src.width, width * 2)].map(Math.round)}
      sizes={`${width}px`}
      formats={['avif', 'webp']}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
    />
  </div>
</div>
