---
import Home from '../index.astro'
import Download from '../download.astro'
import DownloadHistory from '../download/history.astro'
import Changelog from '../changelog.astro'
import Privacy from '../privacy.astro'
import NotFound from '../404.astro'

export function getStaticPaths() {
  return [
    { params: { page: undefined }, props: { Page: Home } },
    { params: { page: 'download' }, props: { Page: Download } },
    { params: { page: 'download/history' }, props: { Page: DownloadHistory } },
    { params: { page: 'changelog' }, props: { Page: Changelog } },
    { params: { page: 'privacy' }, props: { Page: Privacy } },
    { params: { page: '404' }, props: { Page: NotFound } },
  ]
}

const { Page } = Astro.props
---
<Page />
