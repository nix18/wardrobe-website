---
import { translations } from "../lib/translate"
import ReleaseNotes from '../components/ReleaseNotes.astro'
import Base from '../layouts/Base.astro'
import Logo from '../components/Logo.astro'
import Icon from '../components/Icon.astro'
import { latest as latestRelease, downloadUrl, releaseUrl, formatSize, formatDate, apkName, releaseSummary } from '../lib/releases'

const { t, base, locale, language } = translations(Astro.url.pathname)

const latest = await latestRelease()
const v = latest.data.version
---

<Base title={t("Download", "下载")} page="download" description={t("Download Wardrobe v{version} for Android 8.0 or later ({size}). Includes installation and verification instructions.", "下载小衣柜 v{version}（Android 8.0 及以上，{size}）。安装步骤与校验方法。", { version: v, size: formatSize(latest.data.size) })}>
  <section class="dl-hero">
    <div class="wrap">
      <span class="eyebrow">{t("Download", "下载")}</span>
      <h1>{t("Download Wardrobe", "下载小衣柜")}</h1>
      <p class="muted">{t("For phones and tablets running Android 8.0 or later. Free to download, with your own AI provider.", "适用于 Android 8.0 及以上的手机与平板。免费，使用你自己的 AI 服务。")}</p>

      <div class="latest card">
        <div class="latest-main">
          <Logo size={64} />
          <div class="latest-info">
            <div class="latest-title">
              <h2>{t("Wardrobe", "小衣柜")} v{v}</h2>
              <span class="chip chip-clay">{t("Latest version", "最新版本")}</span>
            </div>
            <p class="muted">
              <time datetime={latest.data.date.toISOString()}>{formatDate(latest.data.date, locale)}</time> {t("", "发布")} · {formatSize(latest.data.size)} · Android 8.0+
            </p>
            <p>{releaseSummary(latest, language)}</p>
          </div>
          <a class="btn btn-primary dl-btn" href={downloadUrl(v)} data-download>
            <Icon name="download" size={20} />
            {t("Download APK", "下载 APK")}
          </a>
        </div>
        <div class="hash">
          <span class="muted">SHA-256</span>
          <code id="sha">{latest.data.sha256}</code>
          <button type="button" class="copy" data-copy="#sha" data-copy-label={t("Copy", "复制")} data-copied-label={t("Copied", "已复制")} aria-label={t("Copy SHA-256", "复制 SHA-256")}>
            <Icon name="copy" size={16} />
            <span>{t("Copy", "复制")}</span>
          </button>
        </div>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="wrap two-col">
      <div>
        <h2 class="h-sm">{t("Installation", "安装步骤")}</h2>
        <ol class="steps">
          <li>
            <strong>{t("Download the APK", "下载安装包")}</strong>
            <p>{t("Tap Download APK above in your phone’s browser. The file is named", "在手机浏览器中点击上方的“下载 APK”，文件名为")} <code>{apkName(v)}</code>{t(".", "。")}</p>
          </li>
          <li>
            <strong>{t("Allow installation", "允许安装")}</strong>
            <p>{t("Open the downloaded file. If prompted, allow your browser or file manager to install unknown apps, then tap Install.", "打开下载的文件，系统提示时允许浏览器或文件管理器“安装未知应用”，再点“安装”。")}</p>
          </li>
          <li>
            <strong>{t("Set up an AI provider", "配置 AI 服务")}</strong>
            <p>{t("Accept the privacy policy on first launch. Under Settings › AI Services, select a provider, enter your API key, and test the connection. For AI try-on, add an image generation provider as well.", "首次打开同意隐私政策后，在「设置 › AI 服务」选择服务商、填写 API Key，点“测试连接”。想用 AI 试穿，再添加一个图像生成服务。")}</p>
          </li>
        </ol>
      </div>
      <div>
        <h2 class="h-sm">{t("Verify the APK", "校验安装包")}</h2>
        <p class="muted">{t("Compare the downloaded file’s SHA-256 with the value above to verify its integrity.", "下载后可以核对 SHA-256，确认文件完整、没有被篡改：")}</p>
        <pre><code><span class="muted"># Windows</span>
certutil -hashfile {apkName(v)} SHA256
<span class="muted"># macOS / Linux</span>
shasum -a 256 {apkName(v)}</code></pre>
        <a class="link" href={`${base}download/history/`}>{t("Looking for an older release? View previous versions", "需要旧版本？查看历史版本")}
          <Icon name="arrow" size={16} />
        </a>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="wrap two-col">
      <div>
        <h2 class="h-sm">{t("What’s new in v{version}", "v{version} 更新内容", { version: v })}</h2>
        <a class="link" href={releaseUrl(v)}>{t("View on GitHub", "在 GitHub 上查看")} <Icon name="arrow" size={16} /></a>
      </div>
      <article class="prose card notes">
        <ReleaseNotes release={latest} />
      </article>
    </div>
  </section>

</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      const text = document.querySelector(button.dataset.copy!)?.textContent ?? ''
      try {
        await navigator.clipboard.writeText(text)
        const label = button.querySelector('span')!
        label.textContent = button.dataset.copiedLabel ?? ''
        setTimeout(() => (label.textContent = button.dataset.copyLabel ?? ''), 1600)
      } catch {
        // 不支持剪贴板时选中文字，便于手动复制
        const range = document.createRange()
        range.selectNodeContents(document.querySelector(button.dataset.copy!)!)
        getSelection()?.removeAllRanges()
        getSelection()?.addRange(range)
      }
    })
  })
</script>

<style>
  .dl-hero {
    padding-block: clamp(48px, 7vw, 88px) 32px;
  }

  .dl-hero h1 {
    margin: 16px 0 10px;
    font-size: clamp(36px, 5vw, 56px);
  }

  .latest {
    margin-top: 40px;
    padding: clamp(24px, 4vw, 40px);
    border-radius: var(--radius-xl);
  }

  .latest-main {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 24px;
  }

  .latest-main :global(svg) {
    border-radius: 18px;
    box-shadow: 0 14px 28px -14px rgb(184 90 53 / 0.9);
  }

  .latest-info {
    min-width: 0;
    display: grid;
    gap: 6px;
  }

  .latest-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .latest-title h2 {
    font-size: 26px;
  }

  .dl-btn {
    height: 56px;
    padding-inline: 32px;
  }

  .hash {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 13px;
  }

  .hash code {
    flex: 1;
    min-width: 0;
    padding: 0;
    background: none;
    overflow-wrap: anywhere;
    color: var(--ink-2);
    font: 13px/1.5 var(--mono);
  }

  .copy {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 34px;
    padding: 0 14px;
    border: 0;
    border-radius: 999px;
    background: var(--paper-2);
    color: var(--ink-2);
    font: inherit;
    cursor: pointer;
  }

  .copy:hover {
    background: var(--clay-soft);
    color: var(--clay-ink);
  }

  @media (max-width: 720px) {
    .latest-main {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .dl-btn {
      grid-column: 1 / -1;
    }
  }

  .section-sm {
    padding-block: clamp(32px, 5vw, 56px);
  }

  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 64px);
  }

  .h-sm {
    margin-bottom: 20px;
    font-size: 24px;
  }

  .steps {
    display: grid;
    gap: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .steps li {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    column-gap: 16px;
    counter-increment: step;
  }

  .steps li::before {
    content: counter(step);
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--clay-soft);
    color: var(--clay-ink);
    font-weight: 700;
  }

  .steps p {
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  .steps code {
    white-space: nowrap;
  }

  code {
    padding: 0.1em 0.4em;
    border-radius: 6px;
    background: var(--paper-2);
    font: 0.88em var(--mono);
  }

  pre {
    max-width: 100%;
    min-width: 0;
    margin: 16px 0;
    padding: 20px 22px;
    overflow-x: auto;
    border-radius: var(--radius);
    background: #24201d;
    color: #f3ede6;
    font: 14px/1.8 var(--mono);
  }

  pre code {
    padding: 0;
    background: none;
    font: inherit;
  }

  pre .muted {
    color: #9d9389;
  }

  .link {
    color: var(--clay-ink);
  }

  .link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .notes {
    padding: clamp(24px, 4vw, 36px);
  }

  @media (max-width: 760px) {
    .two-col {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 520px) {
    .latest-main { gap: 16px; }
    .latest-title h2 { font-size: clamp(20px, 5.6vw, 26px); }
    .hash code { flex-basis: 100%; order: 1; }
  }
</style>
