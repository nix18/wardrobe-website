---
import { translations } from "../lib/language"
import Base from '../layouts/Base.astro'
import { Content as PrivacyZh } from '../data/privacy.md'
import { Content as PrivacyEn } from '../data/privacy-en.md'

const { t, language } = translations(Astro.url.pathname)
---

<Base title={t("Privacy policy", "隐私政策")} page="privacy" description={t("What information Wardrobe handles, where it goes, and how you can manage it.", "小衣柜隐私政策：应用处理哪些信息、发送到哪里，以及如何管理。")}>
  <section class="head">
    <div class="wrap narrow">
      <span class="eyebrow">Privacy</span>
      <h1>{t("Privacy policy", "隐私政策")}</h1>
    </div>
  </section>
  <section class="body">
    <article class="wrap narrow prose card">
      {language === 'zh' ? <PrivacyZh /> : <PrivacyEn />}
      <h2>{t("Website language selection", "网站语言选择")}</h2>
      <p>{t("To select a language on your first visit, the website asks ipapi.co for the country associated with your IP address. The provider receives the IP address as part of that request. This does not send any data from the Android app. Selecting a language manually saves that choice in your browser and skips future lookups.", "首次访问时，网站会向 ipapi.co 查询访问 IP 所在的国家或地区，以选择显示语言。查询服务会接收到访问 IP。此过程不发送 Android 应用中的数据。手动选择的语言会保存在浏览器中，之后无需再查询。")}</p>
      <p><a href="https://ipapi.co/privacy/">{t("ipapi.co privacy policy", "ipapi.co 隐私政策")}</a></p>
    </article>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-mail]').forEach((el) => {
    const [user, domain] = el.dataset.mail!.split('|')
    const a = document.createElement('a')
    a.href = `mailto:${user}@${domain}`
    a.textContent = `${user}@${domain}`
    el.replaceWith(a)
  })
</script>

<style>
  .narrow {
    width: min(100% - 2 * var(--gutter), 820px);
  }

  .head {
    padding-block: clamp(48px, 7vw, 88px) clamp(24px, 4vw, 40px);
  }

  .head h1 {
    margin: 16px 0 10px;
    font-size: clamp(36px, 5vw, 56px);
  }

  .body {
    padding-bottom: clamp(48px, 8vw, 96px);
  }

  .prose {
    padding: clamp(28px, 5vw, 56px);
  }

  .prose :global(p:first-of-type) {
    color: var(--muted);
    font-size: 14px;
  }
</style>
