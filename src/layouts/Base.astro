---
import '../styles/global.css'
import Logo from '../components/Logo.astro'
import { latest, downloadUrl } from '../lib/releases'

interface Props {
  title?: string
  description?: string
  /** 当前页（导航高亮） */
  page?: 'home' | 'download' | 'changelog' | 'privacy'
}

const {
  title,
  description = '小衣柜是一款本地优先的 Android 衣橱应用：拍照入库，AI 自动识别标签，用一句话找衣服；挑几件衣服，生成模特的正面、侧面、背面试穿图。',
  page,
} = Astro.props
const fullTitle = title ? `${title} · 小衣柜` : '小衣柜 — 会整理、会试穿的 AI 衣橱'
const base = import.meta.env.BASE_URL
const canonical = new URL(Astro.url.pathname, Astro.site)
const og = new URL(`${base}og.png`, Astro.site)
const release = await latest()
const nav = [
  { href: `${base}#features`, label: '功能', key: 'features' },
  { href: `${base}#screens`, label: '界面', key: 'screens' },
  { href: `${base}changelog/`, label: '更新日志', key: 'changelog' },
  { href: `${base}download/`, label: '下载', key: 'download' },
]
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}icon-180.png`} />
    <meta name="theme-color" content="#f5f0ea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#181513" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="小衣柜" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body data-page={page}>
    <a class="skip visually-hidden" href="#main">跳到正文</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={base} aria-label="小衣柜首页">
          <Logo size={34} />
          <span>小衣柜</span>
        </a>
        <nav aria-label="主导航">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.key === page ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <a class="btn btn-primary btn-sm header-cta" href={downloadUrl(release.data.version)} data-download>
          下载 v{release.data.version}
        </a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div class="footer-brand">
          <a class="brand" href={base}>
            <Logo size={30} />
            <span>小衣柜</span>
          </a>
          <p class="muted">会整理、会试穿的 AI 衣橱。<br />数据留在你的手机里。</p>
        </div>
        <div class="footer-links">
          <div>
            <h3>产品</h3>
            <a href={`${base}#features`}>功能</a>
            <a href={`${base}#screens`}>界面</a>
            <a href={`${base}#faq`}>常见问题</a>
          </div>
          <div>
            <h3>下载</h3>
            <a href={`${base}download/`}>最新版 v{release.data.version}</a>
            <a href={`${base}download/history/`}>历史版本</a>
            <a href={`${base}changelog/`}>更新日志</a>
          </div>
          <div>
            <h3>关于</h3>
            <a href={`${base}privacy/`}>隐私政策</a>
          </div>
        </div>
      </div>
      <div class="wrap footer-bottom muted">
        <span>© {new Date().getFullYear()} 小衣柜</span>
        <span>本网站中的模特、衣物与试穿图片均为 AI 生成的示例。</span>
      </div>
    </footer>

    <script>
      // 滚动到视野内时淡入
      const items = document.querySelectorAll('.reveal')
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('shown')
                io.unobserve(e.target)
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        )
        items.forEach((el) => io.observe(el))
      } else {
        items.forEach((el) => el.classList.add('shown'))
      }
      // 顶栏在滚动后加上分隔线
      const header = document.querySelector('.site-header')
      const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 8)
      onScroll()
      window.addEventListener('scroll', onScroll, { passive: true })
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(18px);
    -webkit-backdrop-filter: saturate(1.4) blur(18px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease;
  }

  .site-header.scrolled {
    border-bottom-color: var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 72px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 18px;
    letter-spacing: 0.02em;
  }

  .brand :global(svg) {
    border-radius: 9px;
    box-shadow: 0 6px 14px -8px rgb(184 90 53 / 0.9);
  }

  nav {
    margin-left: auto;
  }

  nav ul {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: block;
    padding: 8px 14px;
    border-radius: 999px;
    color: var(--ink-2);
    font-size: 15px;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    background: var(--paper-2);
    color: var(--ink);
  }

  @media (max-width: 760px) {
    .header-inner {
      gap: 12px;
    }
    nav ul li:nth-child(-n + 2) {
      display: none;
    }
    nav a {
      padding: 8px 10px;
      font-size: 14px;
    }
    .header-cta {
      display: none;
    }
  }

  .skip:focus {
    position: fixed;
    top: 12px;
    left: 12px;
    width: auto;
    height: auto;
    padding: 8px 14px;
    clip-path: none;
    z-index: 100;
    background: var(--card);
    border-radius: 8px;
  }

  .site-footer {
    margin-top: 40px;
    padding-block: 64px 36px;
    border-top: 1px solid var(--line);
    background: var(--paper-2);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 40px;
  }

  .footer-brand {
    display: grid;
    gap: 16px;
    max-width: 320px;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(32px, 6vw, 80px);
  }

  .footer-links div {
    display: grid;
    align-content: start;
    gap: 10px;
  }

  .footer-links h3 {
    margin-bottom: 4px;
    color: var(--muted);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .footer-links a {
    color: var(--ink-2);
    font-size: 15px;
  }

  .footer-links a:hover {
    color: var(--clay-ink);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: 13px;
  }
</style>
