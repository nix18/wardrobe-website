---
import '../styles/global.css'
import Logo from '../components/Logo.astro'
import { languagePath, translations } from '../lib/language'
import { latest, downloadUrl } from '../lib/releases'

interface Props {
  title?: string
  description?: string
  /** 当前页（导航高亮） */
  page?: 'home' | 'download' | 'changelog' | 'privacy'
}

const { language, base, locale, t } = translations(Astro.url.pathname)
const alternate = language === 'zh' ? 'en' : 'zh'
const alternateLocale = alternate === 'zh' ? 'zh-CN' : 'en'
const alternatePath = languagePath(Astro.url.pathname, alternate)
const brand = t('Wardrobe', '小衣柜')
const {
  title,
  description = t('Wardrobe is a local-first Android app for organizing clothes. Add photos, tag items with AI, search in your own words, and generate front, side, and back try-on images.', '小衣柜是一款本地优先的 Android 衣橱应用：拍照入库，AI 自动识别标签，用一句话找衣服；挑几件衣服，生成模特的正面、侧面、背面试穿图。'),
  page,
} = Astro.props
const fullTitle = title ? `${title} · ${brand}` : t('Wardrobe — Organize clothes and try on outfits with AI', '小衣柜 — 会整理、会试穿的 AI 衣橱')
const canonical = new URL(Astro.url.pathname, Astro.site)
const og = new URL(`${import.meta.env.BASE_URL}og.png`, Astro.site)
const release = await latest()
const nav = [
  { href: `${base}#features`, label: t('Features', '功能'), key: 'features' },
  { href: `${base}#screens`, label: t('Screenshots', '界面'), key: 'screens' },
  { href: `${base}changelog/`, label: t('Changelog', '更新日志'), key: 'changelog' },
  { href: `${base}download/`, label: t('Download', '下载'), key: 'download' },
]
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={alternateLocale} href={new URL(alternatePath, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(languagePath(Astro.url.pathname, 'en'), Astro.site)} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}icon-180.png`} />
    <meta name="theme-color" content="#f5f0ea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#181513" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body data-page={page}>
    <a class="skip visually-hidden" href="#main">{t('Skip to content', '跳到正文')}</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={base} aria-label={t('Wardrobe home', '小衣柜首页')}>
          <Logo size={34} />
          <span>{brand}</span>
        </a>
        <nav aria-label={t('Main navigation', '主导航')}>
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.key === page ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <a class="language-switch" href={`${alternatePath}?lang=${alternate}`} hreflang={alternateLocale} lang={alternateLocale} data-language-switch>
          {alternate === 'en' ? 'English' : '中文'}
        </a>
        <a class="btn btn-primary btn-sm header-cta" href={downloadUrl(release.data.version)} data-download>
          {t('Download', '下载')} v{release.data.version}
        </a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div class="footer-brand">
          <a class="brand" href={base}>
            <Logo size={30} />
            <span>{brand}</span>
          </a>
          <p class="muted">{t('Organize and try on outfits with AI.', '会整理、会试穿的 AI 衣橱。')}<br />{t('Stored on your phone, with optional AI and sync.', '本机保存，按你的选择使用 AI 与同步。')}</p>
        </div>
        <div class="footer-links">
          <div>
            <h3>{t('Product', '产品')}</h3>
            <a href={`${base}#features`}>{t('Features', '功能')}</a>
            <a href={`${base}#screens`}>{t('Screenshots', '界面')}</a>
            <a href={`${base}#faq`}>{t('FAQ', '常见问题')}</a>
          </div>
          <div>
            <h3>{t('Download', '下载')}</h3>
            <a href={`${base}download/`}>{t('Latest version', '最新版')} v{release.data.version}</a>
            <a href={`${base}download/history/`}>{t('Previous versions', '历史版本')}</a>
            <a href={`${base}changelog/`}>{t('Changelog', '更新日志')}</a>
          </div>
          <div>
            <h3>{t('About', '关于')}</h3>
            <a href={`${base}privacy/`}>{t('Privacy policy', '隐私政策')}</a>
          </div>
        </div>
      </div>
      <div class="wrap footer-bottom muted">
        <span>© {new Date().getFullYear()} {brand}</span>
        <span>{t('The models, clothing, and try-on images on this site are AI-generated examples.', '本网站中的模特、衣物与试穿图片均为 AI 生成的示例。')}</span>
      </div>
    </footer>

    <script>
      import '../lib/select-language'

      // 滚动到视野内时淡入
      const items = document.querySelectorAll('.reveal')
      document.documentElement.classList.add('js-reveal')
      // 脚本异常或观察器不可用时仍展示正文。
      const revealAll = () => items.forEach((el) => el.classList.add('shown'))
      setTimeout(revealAll, 2500)
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('shown')
                io.unobserve(e.target)
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        )
        items.forEach((el) => io.observe(el))
      } else {
        items.forEach((el) => el.classList.add('shown'))
      }
      // 顶栏在滚动后加上分隔线
      const header = document.querySelector('.site-header')
      const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 8)
      onScroll()
      window.addEventListener('scroll', onScroll, { passive: true })
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(18px);
    -webkit-backdrop-filter: saturate(1.4) blur(18px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease;
  }

  .site-header.scrolled {
    border-bottom-color: var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 72px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 18px;
    letter-spacing: 0.02em;
  }

  .brand :global(svg) {
    border-radius: 9px;
    box-shadow: 0 6px 14px -8px rgb(184 90 53 / 0.9);
  }

  nav {
    margin-left: auto;
  }

  nav ul {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: block;
    padding: 8px 14px;
    border-radius: 999px;
    color: var(--ink-2);
    font-size: 15px;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    background: var(--paper-2);
    color: var(--ink);
  }

  .language-switch {
    color: var(--ink-2);
    white-space: nowrap;
    font-size: 14px;
    padding-block: 8px;
  }

  .language-switch:hover {
    color: var(--clay-ink);
  }

  @media (max-width: 760px) {
    .header-inner {
      gap: 12px;
    }
    nav ul li:nth-child(-n + 2) {
      display: none;
    }
    nav a {
      padding: 8px 10px;
      font-size: 14px;
    }
    .header-cta {
      display: none;
    }
  }

  @media (max-width: 380px) {
    .header-inner {
      gap: 5px;
    }
    .header-inner .brand {
      gap: 6px;
      font-size: 15px;
    }
    .header-inner .brand :global(svg) {
      width: 26px;
      height: 26px;
      flex-shrink: 0;
    }
    nav a {
      padding-inline: 3px;
      font-size: 12px;
    }
    .language-switch {
      font-size: 13px;
    }
  }

  .skip:focus {
    position: fixed;
    top: 12px;
    left: 12px;
    width: auto;
    height: auto;
    padding: 8px 14px;
    clip-path: none;
    z-index: 100;
    background: var(--card);
    border-radius: 8px;
  }

  .site-footer {
    margin-top: 40px;
    padding-block: 64px 36px;
    border-top: 1px solid var(--line);
    background: var(--paper-2);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 40px;
  }

  .footer-brand {
    display: grid;
    gap: 16px;
    max-width: 320px;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(32px, 6vw, 80px);
  }

  .footer-links div {
    display: grid;
    align-content: start;
    gap: 10px;
  }

  .footer-links h3 {
    margin-bottom: 4px;
    color: var(--muted);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .footer-links a {
    color: var(--ink-2);
    font-size: 15px;
  }

  .footer-links a:hover {
    color: var(--clay-ink);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: 13px;
  }
</style>
