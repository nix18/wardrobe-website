{
  "name": "wardrobe-website",
  "private": true,
  "type": "module",
  "description": "小衣柜的产品网站（GitHub Pages）",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-site.mjs",
    "preview": "astro preview",
    "og-image": "node scripts/og-image.mjs",
    "gen-images": "node scripts/gen-images.mjs",
    "release": "node scripts/publish-release.mjs",
    "deploy": "node scripts/deploy.mjs",
    "readme-images": "node scripts/readme-images.mjs docs/readme",
    "check": "node --test scripts/*.test.mjs",
    "test:layout": "playwright test"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "sharp": "^0.35.5"
  }
}
